{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Lean Pester Tests",
            "type": "shell",
            "command": "PowerShell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Import-Module .\\src\\devshell-orchestrator.psm1 -Force; Run-Tests"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
